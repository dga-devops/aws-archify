  "steps": [
    { "n": 1, "at": [174, 288], "text": "Source systems land files in the **Amazon Simple Storage Service (Amazon S3)** raw zone. Nothing here is ever rewritten, so any downstream change can be replayed." },
    { "n": 2, "at": [359, 288], "text": "**Amazon EventBridge** receives the object-created event and decouples ingest from processing." },
    { "n": 3, "at": [549, 288], "text": "**AWS Lambda** validates the file against its expected schema and routes anything malformed to a quarantine prefix." },
    { "n": 4, "at": [739, 288], "tone": "new", "text": "**AWS Glue** converts each batch to partitioned Parquet." },
    { "n": 5, "at": [989, 288], "tone": "new", "text": "The curated zone holds query-ready data, partitioned by ingest date." },
    { "n": 6, "at": [900, 558], "tone": "new", "text": "**Amazon Athena** queries the curated zone directly, and **Amazon Quick Suite** serves the dashboards analysts actually open." }
