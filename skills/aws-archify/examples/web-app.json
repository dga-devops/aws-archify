  "steps": [
    { "n": 1, "at": [216, 390], "text": "End users reach the application over HTTPS. **Amazon CloudFront** terminates TLS at the edge and serves cached static content." },
    { "n": 2, "at": [361, 390], "text": "**AWS WAF** inspects every request against managed rule groups before it leaves the edge." },
    { "n": 3, "at": [574, 390], "text": "Requests that pass reach the **Application Load Balancer** in the public subnet, which is the only internet-facing component inside the VPC." },
    { "n": 4, "at": [809, 390], "text": "The load balancer forwards to **Amazon Elastic Container Service (Amazon ECS)** tasks on AWS Fargate, running in a private subnet with no route to the internet." },
    { "n": 5, "at": [1069, 390], "text": "Tasks read and write **Amazon Aurora** over TLS in a dedicated data subnet. Credentials come from AWS Secrets Manager at task start." }
